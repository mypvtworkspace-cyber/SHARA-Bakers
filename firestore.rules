rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Settings & Configurations: Public readable for storefront & menu browsing; persistent updates allowed
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Products Catalog: Public readable for storefront; persistent updates allowed
    match /products/{productId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Customer & Staff Orders
    match /orders/{orderId} {
      // Anyone can create or view/update orders (Customer tracking, Admin/Kitchen/Rider status updates)
      allow create, read, update: if true;
      // Strict No-Delete policy for business audit compliance
      allow delete: if false;
    }

    // Audit Logs: Strict audit record - append only, no delete
    match /auditLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Catch-all fallback for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
